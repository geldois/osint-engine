#!/bin/sh
command -v uv >/dev/null 2>&1 || {
    echo "osint-engine: 'uv' not found on PATH — install it (see README: Setup), or bypass once with 'git commit --no-verify'." >&2
    exit 1
}
git diff --quiet || {
    echo "osint-engine: unstaged changes, so the gate would not test exactly this commit." >&2
    echo "  commit everything:      git add -A, then commit again" >&2
    echo "  commit only the staged: git stash push --keep-index --include-untracked, commit, git stash pop" >&2
    exit 1
}
[ -z "$(git ls-files --others --exclude-standard)" ] || {
    echo "osint-engine: untracked files, so the gate would not test exactly this commit." >&2
    echo "  commit them too:        git add -A, then commit again" >&2
    echo "  leave them out:         git stash push --keep-index --include-untracked, commit, git stash pop" >&2
    exit 1
}
exec uv run python -m scripts check
