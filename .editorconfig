root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 88

[*.{json,md,toml,yaml,yml}]
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[.gitconfig]
indent_style = tab
