{
  "lineWidth": 120,
  "indentWidth": 2,
  "newLineKind": "lf",
  "includes": [
    "**/*.json",
    "**/*.yaml",
    "**/*.yml"
  ],
  "excludes": [
    "build/",
    "**/responses/",
    ".cache/",
    ".venv/",
    ".git/",
    "**/__pycache__/"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
