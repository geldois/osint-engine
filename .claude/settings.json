{
  "permissions": {
    "deny": [
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(basedpyright *)",
      "Bash(lint-imports *)",
      "Bash(dprint *)",
      "Bash(sqruff *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(actionlint *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pytest *)",
      "Bash(uv run basedpyright *)",
      "Bash(uv run lint-imports *)",
      "Bash(uv run dprint *)",
      "Bash(uv run sqruff *)",
      "Bash(uv run shellcheck *)",
      "Bash(uv run shfmt *)",
      "Bash(uv run --no-sync ruff *)",
      "Bash(uv run --no-sync pytest *)",
      "Bash(uv run --no-sync basedpyright *)",
      "Bash(uv run --no-sync lint-imports *)",
      "Bash(uv run --no-sync dprint *)",
      "Bash(uv run --no-sync sqruff *)",
      "Bash(uv run --no-sync shellcheck *)",
      "Bash(uv run --no-sync shfmt *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run --no-sync python -m pytest *)",
      "Bash(uv run python -m scripts check *)",
      "Bash(uv run python -m scripts comments *)",
      "Bash(uv run --no-sync python -m scripts check *)",
      "Bash(uv run --no-sync python -m scripts comments *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/mark_docs_review.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/require_docs_review.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
