{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_direct_checks.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_crg_reinstall.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_graph_before_explore.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/autofix_edited_file.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/strip_agent_comments.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/update_graph.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark_architecture_area_touched.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__code-review-graph.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark_graph_used.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v uv >/dev/null 2>&1 || echo 'uv is NOT on PATH — every quality-gate hook runs via `uv run` and is SILENTLY DISABLED right now. Fixing uv on PATH (activate mise / install uv) is absolute priority before any other work.'"
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/graph_status.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/reset_graph_gate.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/nudge_architecture_docs.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
